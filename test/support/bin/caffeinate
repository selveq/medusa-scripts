#!/usr/bin/env node
// Stand-in for caffeinate: records that it was asked, then runs the command the way the real one does.
const { spawnSync } = require('node:child_process')
const fs = require('node:fs')

const argv = process.argv.slice(2)
if (process.env.LMA_TEST_CAFFEINATE_LOG) fs.appendFileSync(process.env.LMA_TEST_CAFFEINATE_LOG, JSON.stringify(argv) + '\n')
// the real one waits out ctrl C and returns what the command returned
process.on('SIGINT', () => {})
const at = argv.findIndex((a) => !a.startsWith('-'))
process.exit(spawnSync(argv[at], argv.slice(at + 1), { stdio: 'inherit' }).status ?? 1)
